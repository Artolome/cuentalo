      "rate": "-4%",
      "pitch": "+0Hz",
      "sha256": "ac5bef8e21f31137c3e576922421e1c31bde0dafdb71af5727b16fcaaeb528d0",
      "duration": 4.32
    },
    "macondo.dialogue.0.1": {
      "file": "macondo.dialogue.0.1.mp3",
      "text": "¡Qué bonitas! Vamos hacia la puerta.",
