      "sha256": "5c940c8dfbb980a2fcdfdc3b346ef37430af4f46311e012d6684e492178be8a2",
      "duration": 2.88
    },
    "macondo.dialogue.3.1": {
      "file": "macondo.dialogue.3.1.mp3",
      "text": "Ahora falta el agua. Vamos al pozo.",
