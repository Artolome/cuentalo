    },
    "macondo.dialogue.4.1": {
      "file": "macondo.dialogue.4.1.mp3",
      "text": "Solo falta llamar a los vecinos.",
      "voice": "es-CO-SalomeNeural",
      "rate": "-4%",
      "pitch": "+3Hz",
      "sha256": "21482fe88d8674c36a8b826b9fc1a5725086ed5d09152f6f283784e4ba239cdc",
      "duration": 3.048
    },
    "macondo.dialogue.5.0": {
      "file": "macondo.dialogue.5.0.mp3",
      "text": "¡La campana suena! La fiesta empieza.",
