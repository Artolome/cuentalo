      "duration": 4.824
    },
    "macondo.dialogue.2.0": {
      "file": "macondo.dialogue.2.0.mp3",
      "text": "Nos invitan a una fiesta en la plaza.",
      "voice": "es-CO-SalomeNeural",
      "rate": "-4%",
      "pitch": "+0Hz",
      "sha256": "ba01687649a26522f46e353e3dbce121cd5796e22be1b73a8e927474b765d553",
